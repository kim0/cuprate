#!/usr/bin/env bash
set -euo pipefail

out_dir="${1:-contrib/guix/out}"
if [[ ! -d "$out_dir" ]]; then
  echo "output directory not found: $out_dir" >&2
  exit 1
fi

(
  cd "$out_dir"
  LC_ALL=C find . -maxdepth 1 -type f -name '*.tar.gz' -printf '%P\0' \
    | LC_ALL=C sort -z \
    | xargs -0r sha256sum > SHA256SUMS
  if [[ ! -s SHA256SUMS ]]; then
    echo "no .tar.gz files found in $out_dir" >&2
    exit 1
  fi
)

echo "Wrote $out_dir/SHA256SUMS"
